# DeepSeek API (used for LLM generation)
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_MODEL=deepseek-v4-flash

# MiniMax API (used for LLM and image generation)
MINIMAX_API_KEY=your_minimax_key
# Optional aliases: MINIMAX_TOKEN / MINIMAX_APIKEY / MINIMAX_API_SECRET / MINIMAX_SUBSCRIPTION_KEY
MINIMAX_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
# Optional MiniMax video endpoints
MINIMAX_VIDEO_API_BASE_URL=
MINIMAX_VIDEO_GENERATION_URL=
MINIMAX_VIDEO_QUERY_URL=
MINIMAX_FILE_RETRIEVE_URL=

# Atlas Cloud LLM (storyboard_script fallback per PRD §5)
# Base URL 默认 https://api.atlascloud.ai/v1；model 必须填 Atlas 账户可用的 Gemini 精确 id
ATLASCLOUD_LLM_BASE_URL=https://api.atlascloud.ai/v1
ATLASCLOUD_LLM_MODEL=

# AI provider strategy: hybrid | deepseek | minimax | openai
AI_PROVIDER=hybrid

# Supabase — Staging (default for local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_staging_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key_only_on_server

# Supabase — Production (Vercel production environment only)
# NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_only_on_server

# Supabase CLI (for database migrations)
# SUPABASE_PROJECT_REF=your-staging-ref-id
# Access token via `supabase login`, never store in .env files

# Server-only admin gate for /admin routes
# Must match the email in admin RLS policies
ADMIN_EMAIL=your-admin@example.com

# Public site origin (used for password-reset redirects)
# Falls back to window.location.origin in local dev
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Stripe Checkout (leave empty in local/staging if billing not configured)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_ANNUAL=

# Rate limits
FREE_MONTHLY_CREDITS=100
AI_RATE_LIMIT_PER_MINUTE=8

# Optional: Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Alibaba Cloud OSS (for NAS backup sync)
ALIBABA_CLOUD_OSS_ACCESS_KEY_ID=
ALIBABA_CLOUD_OSS_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_OSS_BUCKET=
ALIBABA_CLOUD_OSS_ENDPOINT=
ALIBABA_CLOUD_OSS_REGION=

# ============================================================
# 补充：以下变量代码中引用但此前 .env.example 未声明
# ============================================================

# Atlas Cloud API (unified AI model gateway for art generation)
# Used by lib/art/providers/atlas.ts — required when AI_PROVIDER or art selection uses Atlas models
ATLASCLOUD_API_KEY=

# BFL API (Black Forest Labs FLUX models)
# Used by lib/art/providers/flux.ts — required when art selection uses FLUX provider
BFL_API_KEY=

# Art provider access control (Atlas Cloud model gating)
# Set ART_ATLAS_ALLOW_ALL_AUTHENTICATED_USERS=true to allow all logged-in users
# Otherwise whitelist via ART_ATLAS_AUTHORIZED_USER_IDS (comma-separated UUIDs)
# and/or ART_ATLAS_AUTHORIZED_EMAILS (comma-separated emails)
ART_ATLAS_ALLOW_ALL_AUTHENTICATED_USERS=
ART_ATLAS_AUTHORIZED_USER_IDS=
ART_ATLAS_AUTHORIZED_EMAILS=

# Universe engine gating (server-only, NOT exposed to client bundle)
# UNIVERSE_ENGINE_ENABLED=true forces the universe engine on in production (gradual rollout)
# UNIVERSE_DEV_UNLOCK: only effective outside production; dev default is ON, set to "false" to disable
# UNIVERSE_ALLOWLIST_EMAILS: comma-separated emails allowed to access the universe engine (server-only secret)
UNIVERSE_ENGINE_ENABLED=
UNIVERSE_DEV_UNLOCK=
UNIVERSE_ALLOWLIST_EMAILS=

# Video generation timeouts (milliseconds) — used by lib/ai/video/minimax.ts
# Falls back to 90000 / 30000 / 30000 when unset
VIDEO_CREATE_TIMEOUT_MS=
VIDEO_QUERY_TIMEOUT_MS=
VIDEO_RETRIEVE_TIMEOUT_MS=

# MiniMax API optional aliases & endpoint overrides
# Official name is MINIMAX_API_KEY (declared above). The following are legacy aliases
# kept for backward compatibility — prefer MINIMAX_API_KEY in new deployments.
MINIMAX_TOKEN=
MINIMAX_APIKEY=
MINIMAX_API_SECRET=
MINIMAX_SUBSCRIPTION_KEY=
MINIMAX_API_BASE_URL=
MINIMAX_IMAGE_API_BASE_URL=
MINIMAX_ANTHROPIC_API_BASE_URL=

# Universe share (阶段 B) —— 访客访问分享宇宙的 JWT 签名密钥
# 用于签发 /api/universes/[id]/share/verify 返回的 share token（24h 有效期）
# 生产环境务必设置为一个足够随机的长字符串，不要与其它 secret 复用
SHARE_JWT_SECRET=your-share-jwt-secret-here

# --- Sprint 0: compliance export gate flags (default per environment; see lib/compliance/feature-flags.ts) ---
COMPLIANCE_EXPORT_GATE=
EU_ART50_MACHINE_MARKING=
EU_ART50_VISIBLE_DISCLOSURE=
EU_ART50_STRICT_EXPORT_BLOCK=
CN_AIGC_MACHINE_MARKING=
CN_AIGC_VISIBLE_MARKING=
CN_AIGC_STRICT_EXPORT_BLOCK=
DUAL_JURISDICTION_MARKING=
UNMARKED_EXPORT_EXCEPTION=
GDPR_REGION_ROUTING=

# ============================================================
# TRAE-V2-03: Voice TTS Provider
# ============================================================

# TTS provider 选择：placeholder（不可用）/ openai
# 默认 placeholder，需配置 OPENAI_API_KEY 后切换为 openai
TTS_PROVIDER=

# OpenAI TTS（当 TTS_PROVIDER=openai 时必需，二选一）
OPENAI_API_KEY=
OPENAI_TTS_API_KEY=
# 可选：TTS 模型，默认 tts-1
OPENAI_TTS_MODEL=
# 可选：OpenAI API 端点，默认 https://api.openai.com
OPENAI_BASE_URL=

# ============================================================
# TRAE-V2-05: Video Gateway Provider Keys
# ============================================================

# Runway API Key（Runway Gen-4 / Gen-4.5 视频生成）
# 获取：https://runwayml.com/ → Dashboard → API Keys
# 模型默认 gen4_turbo，可通过 RUNWAY_VIDEO_MODEL 覆盖（gen4.5 / veo3.1 / seedance2 等）
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=

# 火山引擎 Ark API Key（Seedance 2.0 直连）
# 获取：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
# 模型默认 doubao-seedance-2-0-260128，可通过 SEEDANCE_VIDEO_MODEL 覆盖
ARK_API_KEY=
# 别名（与 ARK_API_KEY 等价，优先级较低）
VOLC_ARK_API_KEY=
SEEDANCE_VIDEO_MODEL=
# 兼容别名（旧命名，不推荐使用）
ARK_SEEDANCE_MODEL=
