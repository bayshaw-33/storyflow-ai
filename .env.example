DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_MODEL=deepseek-v4-flash
MINIMAX_API_KEY=your_minimax_key
# 可选兼容别名：MINIMAX_TOKEN / MINIMAX_APIKEY / MINIMAX_API_SECRET / MINIMAX_SUBSCRIPTION_KEY
MINIMAX_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
# Optional MiniMax video endpoints. Defaults choose api.minimax.io or api.minimaxi.com by key type.
MINIMAX_VIDEO_API_BASE_URL=
MINIMAX_VIDEO_GENERATION_URL=
MINIMAX_VIDEO_QUERY_URL=
MINIMAX_FILE_RETRIEVE_URL=
AI_PROVIDER=hybrid

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Server-only admin gate for /admin. The /admin/users route only returns data
# when the verified caller's email equals this value. Must match the email used
# in the admin RLS policies (docs/archive/supabase-legacy/supabase-admin-rls.sql). NOT a NEXT_PUBLIC var.
ADMIN_EMAIL=bayshaw33@gmail.com

# Public site origin used to build the password-reset redirect link
# (falls back to window.location.origin in local dev).
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Stripe Checkout. Leave empty in local/staging if you only want profile-plan QA.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PRICE_ELITE_MONTHLY=price_elite_monthly
STRIPE_PRICE_ELITE_ANNUAL=price_elite_annual
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual
STRIPE_PRICE_ULTRA_MONTHLY=price_ultra_monthly
STRIPE_PRICE_ULTRA_ANNUAL=price_ultra_annual

FREE_MONTHLY_CREDITS=100
AI_RATE_LIMIT_PER_MINUTE=8

# Optional
NEXT_PUBLIC_SENTRY_DSN=


# Supabase CLI (for database migrations)
# SUPABASE_PROJECT_REF is NOT a secret — it is your project reference ID
# Find it at: Supabase Dashboard > Project Settings > General > Reference ID
# Used by: supabase link --project-ref <SUPABASE_PROJECT_REF>
# Note: Access token is obtained via interactive `supabase login`, not stored in .env
# SUPABASE_PROJECT_REF=your-project-ref-id
