# DeepSeek API (used for LLM generation)
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_MODEL=deepseek-v4-flash

# MiniMax API (used for LLM and image generation)
MINIMAX_API_KEY=your_minimax_key
# Optional aliases: MINIMAX_TOKEN / MINIMAX_APIKEY / MINIMAX_API_SECRET / MINIMAX_SUBSCRIPTION_KEY
MINIMAX_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
# Optional MiniMax video endpoints
MINIMAX_VIDEO_API_BASE_URL=
MINIMAX_VIDEO_GENERATION_URL=
MINIMAX_VIDEO_QUERY_URL=
MINIMAX_FILE_RETRIEVE_URL=

# AI provider strategy: hybrid | deepseek | minimax | openai
AI_PROVIDER=hybrid

# Supabase — Staging (default for local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_staging_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key_only_on_server

# Supabase — Production (Vercel production environment only)
# NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_only_on_server

# Supabase CLI (for database migrations)
# SUPABASE_PROJECT_REF=your-staging-ref-id
# Access token via `supabase login`, never store in .env files

# Server-only admin gate for /admin routes
# Must match the email in admin RLS policies
ADMIN_EMAIL=your-admin@example.com

# Public site origin (used for password-reset redirects)
# Falls back to window.location.origin in local dev
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Stripe Checkout (leave empty in local/staging if billing not configured)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_ANNUAL=

# Rate limits
FREE_MONTHLY_CREDITS=100
AI_RATE_LIMIT_PER_MINUTE=8

# Optional: Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Alibaba Cloud OSS (for NAS backup sync)
ALIBABA_CLOUD_OSS_ACCESS_KEY_ID=
ALIBABA_CLOUD_OSS_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_OSS_BUCKET=
ALIBABA_CLOUD_OSS_ENDPOINT=
ALIBABA_CLOUD_OSS_REGION=
